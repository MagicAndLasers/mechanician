    "Delete All Conversations": {
      "comment": "Edit menu Undo action name after emptying a workspace. Distinct from the counted form because the user chose \"all\", not a number."
    },
    "Delete Scheduled Task": {
      "comment": "Edit menu Undo action name after deleting one scheduled task. AppKit composes \"Undo \" in front of this."
    },
