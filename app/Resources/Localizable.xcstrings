    "Pin Conversation": {
      "comment": "Conversation sidebar context-menu action that pins one conversation."
    },
    "Move Attachment": {
      "comment": "Edit menu Undo action name after reordering an attachment in the composer."
    },
    "New Conversation": {
      "comment": "File menu item that starts a conversation. Verb phrase, not a label for an existing one."
    },
    "Redo": {
      "comment": "Edit menu item when there is nothing named to redo."
